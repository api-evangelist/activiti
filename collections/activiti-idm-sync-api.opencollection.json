{
  "opencollection": "1.0.0",
  "info": {
    "name": "Activiti Public Rest About IDM Sync API",
    "version": "1.4.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "IDM Sync",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "getSyncLogEntries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{host}/activiti-app/api/enterprise/idm-sync-log-entries",
            "params": [
              {
                "name": "tenantId",
                "value": "",
                "type": "query",
                "description": "tenantId"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "page"
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "size"
              }
            ]
          },
          "docs": "getSyncLogEntries"
        },
        {
          "info": {
            "name": "getLogFile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{host}/activiti-app/api/enterprise/idm-sync-log-entries/:syncLogEntryId/logfile",
            "params": [
              {
                "name": "syncLogEntryId",
                "value": "",
                "type": "path",
                "description": "syncLogEntryId"
              }
            ]
          },
          "docs": "getLogFile"
        }
      ]
    }
  ],
  "bundled": true
}