{
  "opencollection": "1.0.0",
  "info": {
    "name": "Activiti Public Rest About Task CheckList API",
    "version": "1.4.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Task CheckList",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve Checklist added to a task",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{host}/activiti-app/api/enterprise/tasks/:taskId/checklist",
            "params": [
              {
                "name": "taskId",
                "value": "",
                "type": "path",
                "description": "taskId"
              }
            ]
          },
          "docs": "Retrieve Checklist added to a task"
        },
        {
          "info": {
            "name": "Create a task checklist",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{host}/activiti-app/api/enterprise/tasks/:taskId/checklist",
            "params": [
              {
                "name": "taskId",
                "value": "",
                "type": "path",
                "description": "taskId"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a task checklist"
        },
        {
          "info": {
            "name": "Change the order of items on a checklist",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{host}/activiti-app/api/enterprise/tasks/:taskId/checklist",
            "params": [
              {
                "name": "taskId",
                "value": "",
                "type": "path",
                "description": "taskId"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Change the order of items on a checklist"
        }
      ]
    }
  ],
  "bundled": true
}