{
  "opencollection": "1.0.0",
  "info": {
    "name": "Activiti Public Rest About Groups API",
    "version": "1.4.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Groups",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{host}/activiti-app/api/enterprise/groups",
            "params": [
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "filter"
              },
              {
                "name": "groupId",
                "value": "",
                "type": "query",
                "description": "groupId"
              },
              {
                "name": "externalId",
                "value": "",
                "type": "query",
                "description": "externalId"
              },
              {
                "name": "externalIdCaseInsensitive",
                "value": "",
                "type": "query",
                "description": "externalIdCaseInsensitive"
              },
              {
                "name": "tenantId",
                "value": "",
                "type": "query",
                "description": "tenantId"
              }
            ]
          },
          "docs": "List groups"
        },
        {
          "info": {
            "name": "List users member of a specific group",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{host}/activiti-app/api/enterprise/groups/:groupId/users",
            "params": [
              {
                "name": "groupId",
                "value": "",
                "type": "path",
                "description": "groupId"
              }
            ]
          },
          "docs": "List users member of a specific group"
        }
      ]
    }
  ],
  "bundled": true
}