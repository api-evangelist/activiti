{
  "opencollection": "1.0.0",
  "info": {
    "name": "Activiti Public Rest About System Properties API",
    "version": "1.4.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "System Properties",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve System Properties",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{host}/activiti-app/api/enterprise/system/properties"
          },
          "docs": "Typical value is AllowInvolveByEmail"
        }
      ]
    }
  ],
  "bundled": true
}