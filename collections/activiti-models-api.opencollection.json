          "http": {
            "method": "POST",
            "url": "https://{host}/activiti-app/api/enterprise/models/:modelId/clone",
            "params": [
              {
                "name": "modelId",
                "value": "",
                "type": "path",
                "description": "modelId"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "To duplicate an existing model"
        },
        {
          "info": {
            "name": "Get the JSON model",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{host}/activiti-app/api/enterprise/models/:modelId/editor/json",
            "params": [
              {
                "name": "modelId",
                "value": "",
                "type": "path",
                "description": "modelId"
              }
            ]
          },
          "docs": "Get the JSON model"
